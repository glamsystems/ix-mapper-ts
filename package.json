{
  "name": "@glamsystems/ix-mapper",
  "version": "0.3.0-test.1",
  "packageManager": "npm@11.6.2",
  "description": "Map Solana program instructions to GLAM integration instructions",
  "main": "./core.cjs",
  "module": "./core.esm.mjs",
  "types": "./core.d.ts",
  "exports": {
    ".": {
      "types": "./core.d.ts",
      "import": "./core.esm.mjs",
      "require": "./core.cjs"
    },
    "./core": {
      "types": "./core.d.ts",
      "import": "./core.esm.mjs",
      "require": "./core.cjs"
    },
    "./legacy-web3": {
      "types": "./legacy-web3.d.ts",
      "import": "./legacy-web3.esm.mjs",
      "require": "./legacy-web3.cjs"
    },
    "./artifacts/*": "./artifacts/*",
    "./compatibility-evaluations/*": "./compatibility-evaluations/*",
    "./compatibility-manifests/*": "./compatibility-manifests/*",
    "./instruction-classifications-v1/*": "./instruction-classifications-v1/*",
    "./operation-profiles-v1/*": "./operation-profiles-v1/*",
    "./mapping-configs-v2/*": "./mapping-configs-v2/*",
    "./mapping-configs-v2-staging/*": "./mapping-configs-v2-staging/*",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "homepage": "https://www.glam.systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamsystems/ix-mapper-ts.git"
  },
  "keywords": [
    "glam",
    "solana",
    "defi"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "npm run test:types && vitest run --globals",
    "test:types": "tsc -p tsconfig.test-types.json",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "prepack": "npm test && npm run verify:artifacts && npm run build && npm run verify:packed-consumer",
    "verify:packed-consumer": "node scripts/verify-packed-consumer.mjs",
    "pack:contract": "node scripts/build-publication-contract.mjs",
    "verify:publication-contract": "node scripts/verify-publication-contract.mjs",
    "verify:publication-adversarial": "node scripts/verify-publication-adversarial.mjs",
    "verify:publication-reproducibility": "node scripts/verify-publication-reproducibility.mjs",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "files": [
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "artifacts/**/*.json",
    "compatibility-evaluations/**/*.json",
    "compatibility-manifests/**/*.json",
    "instruction-classifications-v1/**/*.json",
    "operation-profiles-v1/**/*.json",
    "core.cjs",
    "core.esm.mjs",
    "core.d.ts",
    "legacy-web3.cjs",
    "legacy-web3.esm.mjs",
    "legacy-web3.d.ts",
    "mapping-configs-v2/**/*.json",
    "mapping-configs-v2-staging/**/*.json",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@kamino-finance/klend-sdk": "9.1.5",
    "@solana/kit": "2.3.0",
    "@solana/web3.js": "1.98.4",
    "@types/node": "20.19.39",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
