{
  "name": "@glamsystems/ix-mapper",
  "version": "0.3.0",
  "description": "Maps an instruction a protocol's own SDK built onto the GLAM instruction that carries it, from the generated mapping documents it bundles.",
  "homepage": "https://www.glam.systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamsystems/ix-mapper-ts.git"
  },
  "keywords": [
    "glam",
    "solana",
    "defi"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./web3": {
      "import": {
        "types": "./dist/web3.d.ts",
        "default": "./dist/web3.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  }
}
