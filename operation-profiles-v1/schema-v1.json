{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idl.glam.systems/schemas/operation-profile-v1.json",
  "title": "GLAM complete-operation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "config_revision",
    "integration",
    "operations"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "config_revision": { "type": "integer", "minimum": 1 },
    "integration": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "public_key": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "byte_array": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 1,
      "maxItems": 1232
    },
    "setup_binding": {
      "enum": [
        "ata_payer",
        "derived_associated_token_account",
        "glam_vault",
        "protocol_token_mint",
        "protocol_token_program"
      ]
    },
    "setup_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "role": { "type": "integer", "minimum": 0, "maximum": 3 },
        "account": { "$ref": "#/$defs/public_key" },
        "binding": { "$ref": "#/$defs/setup_binding" }
      },
      "oneOf": [{ "required": ["account"] }, { "required": ["binding"] }]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "position",
        "program_id",
        "instruction",
        "exact_data",
        "accounts"
      ],
      "properties": {
        "outcome": { "const": "operationBoundPassthrough" },
        "position": { "const": 0 },
        "program_id": { "$ref": "#/$defs/public_key" },
        "instruction": { "type": "string", "minLength": 1 },
        "exact_data": { "$ref": "#/$defs/byte_array" },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/setup_account" }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_position",
        "source_instruction",
        "minimum_count",
        "maximum_count",
        "owner_account_index",
        "token_account_index",
        "token_mint_index",
        "token_program_index",
        "forbidden_mint_account_indices",
        "forbidden_mints"
      ],
      "properties": {
        "start_position": { "const": 1 },
        "source_instruction": { "enum": ["deposit", "withdraw"] },
        "minimum_count": { "type": "integer", "minimum": 1 },
        "maximum_count": { "type": "integer", "minimum": 1, "maximum": 25 },
        "owner_account_index": { "type": "integer", "minimum": 0 },
        "token_account_index": { "type": "integer", "minimum": 0 },
        "token_mint_index": { "type": "integer", "minimum": 0 },
        "token_program_index": { "type": "integer", "minimum": 0 },
        "forbidden_mint_account_indices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "forbidden_mints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/public_key" },
          "uniqueItems": true
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "official_emitter",
        "bounded_binding",
        "setup",
        "protocol"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["deposit", "withdraw"] },
        "official_emitter": { "type": "string", "minLength": 1 },
        "bounded_binding": { "type": "string", "minLength": 1 },
        "setup": { "$ref": "#/$defs/setup" },
        "protocol": { "$ref": "#/$defs/protocol" }
      }
    }
  }
}
