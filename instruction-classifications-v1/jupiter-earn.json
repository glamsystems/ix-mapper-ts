    {
      "id": "jupiter-earn.remaining-or-extra",
      "outcome": "unsupported",
      "program_id": "jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9",
      "instruction": "remaining/reordered/extra output",
      "phase": "protocol",
      "emitted_by": ["operation caller"],
      "condition": "any setup, cleanup, protocol instruction, account, tail, duplicate, or reordering exists outside the exact single-instruction operation",
      "reason": "The operation matcher rejects every extra, missing, duplicated, or reordered instruction and every remaining account."
