    {
      "id": "jupiter-earn.alternate-program",
      "outcome": "unsupported",
      "program_id": "jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9",
      "instruction": "alternate Lending/Liquidity program tuple",
      "phase": "protocol",
      "emitted_by": ["operation caller"],
      "condition": "either native program identity differs from the pinned main-market tuple",
      "reason": "Program selection is an explicit profile input and cannot inherit an override."
