      "program_id": "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
      "instruction": "Token-2022 Earn path",
      "phase": "setup",
      "emitted_by": ["caller setup", "@jup-ag/lend Earn helpers"],
      "condition": "the underlying or f-token mint uses Token-2022",
      "reason": "The first profile pins classic SPL Token for both mints."
    },
    {
      "id": "jupiter-earn.wrapped-sol",
      "outcome": "unsupported",
      "program_id": "11111111111111111111111111111111",
      "instruction": "wrapped-SOL setup/cleanup",
      "phase": "setup",
      "emitted_by": ["caller setup", "@jup-ag/lend Earn helpers"],
