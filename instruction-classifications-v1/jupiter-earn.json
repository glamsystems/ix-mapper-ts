    {
      "id": "jupiter-earn.unbounded-redeem",
      "outcome": "unsupported",
      "program_id": "jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9",
      "instruction": "redeem",
      "phase": "protocol",
