{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idl.glam.systems/schemas/operation-profile-v2.json",
  "title": "GLAM state-bound complete-operation profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "config_revision",
    "integration",
    "official_sdk_tuple",
    "operations"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 2 },
    "config_revision": { "type": "integer", "minimum": 1 },
    "integration": { "enum": ["kamino-lending-repay", "kamino-farms-stake", "jupiter-earn"] },
    "official_sdk_tuple": { "type": "object" },
    "operations": {
      "type": "array",
      "minItems": 1
    }
  },
  "oneOf": [
    {
      "required": ["integration", "official_sdk_tuple", "operations"],
      "properties": {
        "integration": { "const": "kamino-lending-repay" },
        "official_sdk_tuple": { "$ref": "#/$defs/sdk_tuple" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    {
      "required": ["integration", "official_sdk_tuple", "operations"],
      "properties": {
        "integration": { "const": "kamino-farms-stake" },
        "official_sdk_tuple": { "$ref": "#/$defs/farms_sdk_tuple" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/farms_operation" }
        }
      }
    },
    {
      "required": ["integration", "official_sdk_tuple", "operations"],
      "properties": {
        "integration": { "const": "jupiter-earn" },
        "official_sdk_tuple": { "$ref": "#/$defs/jupiter_sdk_tuple" },
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": ["id", "operation"],
              "properties": {
                "id": { "const": "jupiter-earn.main-classic-spl-deposit-with-min-out" },
                "operation": { "const": "depositWithMinAmountOut" }
              }
            },
            {
              "type": "object",
              "required": ["id", "operation"],
              "properties": {
                "id": { "const": "jupiter-earn.main-classic-spl-redeem-with-min-out" },
                "operation": { "const": "redeemWithMinAmountOut" }
              }
            }
          ],
          "items": { "$ref": "#/$defs/jupiter_operation" }
        }
      }
    }
  ],
  "$defs": {
    "public_key": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_array": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 1,
      "maxItems": 1232
    },
    "sdk_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "npm_integrity",
        "tarball_sha256",
        "solana_kit_version",
        "source_hashes"
      ],
      "properties": {
        "package": { "const": "@kamino-finance/klend-sdk" },
        "version": { "const": "9.1.5" },
        "npm_integrity": { "type": "string", "minLength": 1 },
        "tarball_sha256": { "$ref": "#/$defs/sha256" },
        "solana_kit_version": { "const": "2.3.0" },
        "source_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refresh_reserve_builder",
            "refresh_obligation_builder",
            "repay_v2_builder",
            "high_level_action_helper"
          ],
          "properties": {
            "refresh_reserve_builder": { "$ref": "#/$defs/sha256" },
            "refresh_obligation_builder": { "$ref": "#/$defs/sha256" },
            "repay_v2_builder": { "$ref": "#/$defs/sha256" },
            "high_level_action_helper": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "farms_sdk_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "native_idl_version", "npm_integrity", "tarball_sha256", "solana_kit_version", "source_hashes"],
      "properties": {
        "package": { "const": "@kamino-finance/farms-sdk" },
        "version": { "const": "3.2.26" },
        "native_idl_version": { "const": "1.6.5" },
        "npm_integrity": { "type": "string", "minLength": 1 },
        "tarball_sha256": { "$ref": "#/$defs/sha256" },
        "solana_kit_version": { "const": "2.3.0" },
        "source_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["farms_client", "operations", "pda_helpers", "initialize_user_builder", "stake_builder"],
          "properties": {
            "farms_client": { "$ref": "#/$defs/sha256" },
            "operations": { "$ref": "#/$defs/sha256" },
            "pda_helpers": { "$ref": "#/$defs/sha256" },
            "initialize_user_builder": { "$ref": "#/$defs/sha256" },
            "stake_builder": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "jupiter_sdk_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "native_idl_version", "npm_integrity", "tarball_sha256", "solana_kit_version", "source_hashes"],
      "properties": {
        "package": { "const": "@jup-ag/lend" },
        "version": { "const": "0.1.10" },
        "native_idl_version": { "const": "0.1.0" },
        "npm_integrity": { "type": "string", "minLength": 1 },
        "tarball_sha256": { "$ref": "#/$defs/sha256" },
        "solana_kit_version": { "const": "2.3.0" },
        "source_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_earn_entry", "native_idl", "portable_binding", "operation_vectors", "portable_instructions", "portable_enumeration", "portable_structural", "portable_differential"],
          "properties": {
            "official_earn_entry": { "$ref": "#/$defs/sha256" },
            "native_idl": { "$ref": "#/$defs/sha256" },
            "portable_binding": { "$ref": "#/$defs/sha256" },
            "operation_vectors": { "$ref": "#/$defs/sha256" },
            "portable_instructions": { "$ref": "#/$defs/sha256" },
            "portable_enumeration": { "$ref": "#/$defs/sha256" },
            "portable_structural": { "$ref": "#/$defs/sha256" },
            "portable_differential": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "jupiter_external_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "market", "lending_program", "liquidity_program", "reward_rate_model_program", "asset_token_program", "f_token_program", "associated_token_program", "system_program", "setup", "base_commit", "hardening_commit"],
      "properties": {
        "profile": { "const": "jupiter-earn-main-classic-spl-v1" },
        "market": { "const": "main" },
        "lending_program": { "const": "jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9" },
        "liquidity_program": { "const": "jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC" },
        "reward_rate_model_program": { "const": "jup7TthsMgcR9Y3L277b8Eo9uboVSmu1utkuXHNUKar" },
        "asset_token_program": { "const": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        "f_token_program": { "const": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        "associated_token_program": { "const": "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" },
        "system_program": { "const": "11111111111111111111111111111111" },
        "setup": { "const": "none" },
        "base_commit": { "const": "4053ffbad104ce7f17505f4b3b85d5b1b414fc37" },
        "hardening_commit": { "const": "356ed8420edc24ceb518d88440f4e17c24378c61" }
      }
    },
    "account_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role", "binding"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "role": { "type": "integer", "minimum": 0, "maximum": 3 },
        "binding": { "type": "string", "minLength": 1 }
      }
    },
    "refresh_reserves": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "position_start",
        "program_id",
        "instruction",
        "exact_data",
        "accounts",
        "ordering"
      ],
      "properties": {
        "outcome": { "const": "operationBoundPassthrough" },
        "position_start": { "const": 0 },
        "program_id": { "$ref": "#/$defs/public_key" },
        "instruction": { "const": "refreshReserve" },
        "exact_data": { "$ref": "#/$defs/byte_array" },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/account_binding" }
        },
        "ordering": {
          "const": "deposits-then-borrows-deduplicated-target-last"
        }
      }
    },
    "refresh_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "position",
        "program_id",
        "instruction",
        "exact_data",
        "fixed_accounts",
        "remaining_accounts"
      ],
      "properties": {
        "outcome": { "const": "operationBoundPassthrough" },
        "position": { "const": "after-refresh-reserves" },
        "program_id": { "$ref": "#/$defs/public_key" },
        "instruction": { "const": "refreshObligation" },
        "exact_data": { "$ref": "#/$defs/byte_array" },
        "fixed_accounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/account_binding" }
        },
        "remaining_accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "binding", "referrer_tail"],
          "properties": {
            "role": { "const": 1 },
            "binding": { "const": "deposit_reserves_then_borrow_reserves" },
            "referrer_tail": { "const": "forbidden" }
          }
        }
      }
    },
    "mapped_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "position",
        "source_instruction",
        "mapping_ref",
        "account_bindings"
      ],
      "properties": {
        "outcome": { "const": "mapped" },
        "position": { "const": "final" },
        "source_instruction": { "const": "repay_obligation_liquidity_v2" },
        "mapping_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_schema_version", "config_revision"],
          "properties": {
            "config_schema_version": { "const": 2 },
            "config_revision": { "const": 1 }
          }
        },
        "account_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/account_binding" }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "builder_authority",
        "ordering_evidence",
        "bounded_binding",
        "maximum_active_reserves",
        "maximum_snapshot_age_slots",
        "amount",
        "token_program",
        "associated_token_program",
        "farms_program",
        "forbidden_liquidity_mints",
        "forbidden_helpers",
        "sequence"
      ],
      "properties": {
        "id": { "const": "klend.existing-obligation-classic-spl-repay-v2" },
        "operation": { "const": "repayObligationLiquidityV2" },
        "builder_authority": {
          "const": "@kamino-finance/klend-sdk generated builders"
        },
        "ordering_evidence": {
          "const": "pinned KaminoAction.buildRepayTxns source"
        },
        "bounded_binding": {
          "const": "official decoded Kamino market/obligation/reserve snapshot plus immutable helper output"
        },
        "maximum_active_reserves": { "const": 20 },
        "maximum_snapshot_age_slots": { "const": 20 },
        "amount": { "const": "positive-finite-u64" },
        "token_program": {
          "const": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
        },
        "associated_token_program": {
          "const": "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"
        },
        "farms_program": {
          "const": "FarmsPZpWu9i7Kky8tPN37rs2TpmMrAZrC7S7vJa91Hr"
        },
        "forbidden_liquidity_mints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "So11111111111111111111111111111111111111112"
          }
        },
        "forbidden_helpers": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "associated-token-account",
              "compute-budget",
              "elevation-group",
              "farms",
              "fixed-term",
              "initialization",
              "lookup-table",
              "referrer",
              "repay-all",
              "scope-refresh",
              "token-2022",
              "wrapped-sol"
            ]
          }
        },
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refresh_reserves", "refresh_obligation", "protocol"],
          "properties": {
            "refresh_reserves": { "$ref": "#/$defs/refresh_reserves" },
            "refresh_obligation": { "$ref": "#/$defs/refresh_obligation" },
            "protocol": { "$ref": "#/$defs/mapped_protocol" }
          }
        }
      }
    },
    "farms_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "official_emitter", "bounded_binding", "user_state", "atomic", "maximum_snapshot_age_slots", "amount", "farms_program", "token_program", "associated_token_program", "scope_prices", "sequence"],
      "properties": {
        "id": { "enum": ["farms.existing-user-classic-spl-stake", "farms.first-stake-classic-spl"] },
        "operation": { "enum": ["stake", "initializeAndStake"] },
        "official_emitter": { "type": "string", "minLength": 1 },
        "bounded_binding": { "const": "pinned decoded farm state plus immutable official helper output" },
        "user_state": { "enum": ["existing", "absent"] },
        "atomic": { "const": true },
        "maximum_snapshot_age_slots": { "const": 20 },
        "amount": { "const": "positive-finite-u64" },
        "farms_program": { "const": "FarmsPZpWu9i7Kky8tPN37rs2TpmMrAZrC7S7vJa91Hr" },
        "token_program": { "const": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        "associated_token_program": { "const": "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" },
        "scope_prices": { "const": "none-program-sentinel" },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "outcome", "source_instruction", "account_bindings"],
            "properties": {
              "position": { "type": "integer", "minimum": 0, "maximum": 1 },
              "outcome": { "const": "mapped" },
              "source_instruction": { "enum": ["initialize_user", "stake"] },
              "account_bindings": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": { "$ref": "#/$defs/account_binding" }
              }
            }
          }
        }
      }
    },
    "jupiter_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "official_emitter", "bounded_binding", "external_profile", "atomic", "maximum_snapshot_age_slots", "amounts", "requires_existing_atas", "sequence"],
      "properties": {
        "id": { "enum": ["jupiter-earn.main-classic-spl-deposit-with-min-out", "jupiter-earn.main-classic-spl-redeem-with-min-out"] },
        "operation": { "enum": ["depositWithMinAmountOut", "redeemWithMinAmountOut"] },
        "official_emitter": { "type": "string", "minLength": 1 },
        "bounded_binding": { "const": "pinned decoded Lending/TokenReserve state plus immutable jupiter-earn-main-classic-spl-v1 output" },
        "external_profile": { "$ref": "#/$defs/jupiter_external_profile" },
        "atomic": { "const": true },
        "maximum_snapshot_age_slots": { "const": 20 },
        "amounts": { "enum": ["nonzero-u64-assets-and-min-out", "nonzero-u64-shares-and-min-out"] },
        "requires_existing_atas": { "const": true },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "outcome", "source_instruction", "account_bindings"],
            "properties": {
              "position": { "const": 0 },
              "outcome": { "const": "mapped" },
              "source_instruction": { "enum": ["deposit_with_min_amount_out", "redeem_with_min_amount_out"] },
              "account_bindings": {
                "type": "array",
                "minItems": 17,
                "maxItems": 18,
                "items": { "$ref": "#/$defs/account_binding" }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": { "const": "jupiter-earn.main-classic-spl-deposit-with-min-out" },
            "operation": { "const": "depositWithMinAmountOut" },
            "official_emitter": { "const": "@jup-ag/lend Program.methods.depositWithMinAmountOut + bounded portable binding" },
            "amounts": { "const": "nonzero-u64-assets-and-min-out" },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "source_instruction": { "const": "deposit_with_min_amount_out" },
                  "account_bindings": { "type": "array", "minItems": 17, "maxItems": 17 }
                }
              }
            }
          }
        },
        {
          "properties": {
            "id": { "const": "jupiter-earn.main-classic-spl-redeem-with-min-out" },
            "operation": { "const": "redeemWithMinAmountOut" },
            "official_emitter": { "const": "@jup-ag/lend Program.methods.redeemWithMinAmountOut + bounded portable binding" },
            "amounts": { "const": "nonzero-u64-shares-and-min-out" },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "source_instruction": { "const": "redeem_with_min_amount_out" },
                  "account_bindings": { "type": "array", "minItems": 18, "maxItems": 18 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
